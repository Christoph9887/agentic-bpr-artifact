# Copy this file to `.env` and put your own key in it. Nothing in this artifact
# ships a key.
#
# Only the closed loop calls a model, which is stage 3 of `reproduce_run.py`.
# Detection, the baseline simulation and `reproduce_results.py` make no call and
# need no key at all.
#
# Any OpenAI-compatible endpoint works; the model the nine reported runs used is
# named in `mabpr/config.py`.
OPENAI_API_KEY=
